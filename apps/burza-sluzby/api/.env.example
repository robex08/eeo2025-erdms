# Burza Sluzby API - local config

# Central auth endpoint used for session validation
BURZA_AUTH_ME_URL=http://localhost/auth/me
BURZA_AUTH_HOST_HEADER=erdms.zachranka.cz

# Local DEV auth for admin fallback (disabled by default)
BURZA_LOCAL_AUTH_ENABLED=0

# New Entra users: 0 = waiting for admin approval, 1 = active immediately
BURZA_NEW_ENTRA_USERS_ACTIVE=0

# Local Burza DB (for users + app rights)
BURZA_DB_HOST=127.0.0.1
BURZA_DB_PORT=3306
BURZA_DB_NAME=burza-sluzby-dev
BURZA_DB_USER=burza_user
BURZA_DB_PASSWORD=your_secure_password_here
