# =============================================================================
# ENVIRONMENT CONFIGURATION - TEMPLATE
# =============================================================================
# 
# ⚠️ DŮLEŽITÉ:
# - Tento soubor je POUZE TEMPLATE pro dokumentaci
# - Skutečný .env soubor NENÍ v GIT (je v .gitignore)
# - Pro DEV použij hodnoty níže
# - Pro PRODUCTION kontaktuj admina nebo zkontroluj produkční server
#
# =============================================================================

#
# 📋 DEPLOYMENT GUIDE FOR SUPPLIERS PERMISSIONS
#
# ----
# bude se tyka jen urciteho DEPLOYMENT - leden 2026. pak jej budeme ignorovat
# Dokument DEPLOYMENT_GUIDE_SUPPLIERS_PERMISSIONS_v2.00.md je připraven k použití! 📋
# tak poporsim o kompletni build dle build.md 
# verze 2.13 VSUDE  .env* , json, index atd.
# 
# zaloha full backup ostre DB : eeo2025  /var/www/__BCK_PRODUKCE/2026-01-15
# build pro :dev explicit DB EEO-OSTRA-DEV
# build pro PROD db: eeo2025  / vc. uktulaizace a presunu FE a BE do PRODUKCE.
# VZDY vse S POTVRZENIM
# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

DB_HOST=10.3.172.11
DB_PORT=3306

# DEV DATABASE (EXPLICIT!):
# ⚠️ PRO DEV BUILD --explicit MUSÍ BÝT:
DB_NAME=EEO-OSTRA-DEV

# PRODUCTION DATABASE (NIKDY NEMĚNIT BEZ POTVRZENÍ!):
# DB_NAME=eeo2025

DB_USER=erdms_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# FRONTEND BASE URL
# -----------------------------------------------------------------------------
# ⚠️ KRITICKÉ: URL frontendu pro emaily a notifikace
# DEV:
FRONTEND_BASE_URL=https://erdms.zachranka.cz/dev/eeo-v2

# PRODUCTION:
# FRONTEND_BASE_URL=https://erdms.zachranka.cz/eeo-v2

# -----------------------------------------------------------------------------
# APPLICATION VERSION
# -----------------------------------------------------------------------------
# DEV:
REACT_APP_VERSION=2.40-DEV

# PRODUCTION:
REACT_APP_VERSION=2.40

# -----------------------------------------------------------------------------
# UPLOAD PATHS
# -----------------------------------------------------------------------------
# ⚠️ KRITICKÉ: Tyto cesty určují, kam se ukládají přílohy!

# Environment type - CRITICAL for automatic path detection
APP_ENV=development

# DEV používá /var/www/erdms-dev/data/ (testovací data):
UPLOAD_ROOT_PATH=/var/www/erdms-dev/data/eeo-v2/prilohy/
DOCX_TEMPLATES_PATH=/var/www/erdms-dev/data/eeo-v2/sablony/
MANUALS_PATH=/var/www/erdms-dev/data/eeo-v2/manualy/

# PRODUCTION používá /var/www/erdms-platform/data/ (OSTRÁ DATA!):
# APP_ENV=production  
# UPLOAD_ROOT_PATH=/var/www/erdms-platform/data/eeo-v2/prilohy/
# DOCX_TEMPLATES_PATH=/var/www/erdms-platform/data/eeo-v2/sablony/
# MANUALS_PATH=/var/www/erdms-platform/data/eeo-v2/manualy/

# -----------------------------------------------------------------------------
# AI CHAT CONFIG (BACKEND ONLY)
# -----------------------------------------------------------------------------
# Pozn.: Klice drzet pouze na backendu. Frontend nesmi obsahovat OPENROUTER key.

OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ROUTER_MODEL=openrouter/free
OPENROUTER_SQL_MODEL=openrouter/free

# Open-Meteo (stejny zdroj jako dashboard weather widget)
AI_WEATHER_URL_TEMPLATE=https://api.open-meteo.com/v1/forecast?latitude=50.1479&longitude=14.1095&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,apparent_temperature,is_day,wind_gusts_10m,surface_pressure,precipitation&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=Europe%2FPrague&wind_speed_unit=kmh

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# 1. DEV server (/var/www/erdms-dev/):
#    - Používá eeo2025-dev databázi
#    - Ukládá do /var/www/erdms-dev/data/
#    - Port 3001 (Apache Alias /dev/)
#
# 2. PRODUCTION server (/var/www/erdms-platform/):
#    - Používá eeo2025 databázi
#    - Ukládá do /var/www/erdms-platform/data/
#    - Hlavní doména
#
# 3. NIKDY neměnit produkční .env bez explicitního potvrzení!
#
# =============================================================================
