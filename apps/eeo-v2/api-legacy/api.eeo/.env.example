# verze 2.13 VSUDE  .env* , json, index atd.
# 
# zaloha full backup ostre DB : eeo2025  /var/www/__BCK_PRODUKCE/2026-01-15
# build pro :dev explicit DB EEO-OSTRA-DEV
# build pro PROD db: eeo2025  / vc. uktulaizace a presunu FE a BE do PRODUKCE.
# VZDY vse S POTVRZENIM
# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

DB_HOST=10.3.172.11
DB_PORT=3306

# DEV DATABASE (EXPLICIT!):
# ⚠️ PRO DEV BUILD --explicit MUSÍ BÝT:
DB_NAME=EEO-OSTRA-DEV

# PRODUCTION DATABASE (NIKDY NEMĚNIT BEZ POTVRZENÍ!):
# DB_NAME=eeo2025
/home/holovsky/Obrázky/Screenshot_20260125_153128.png
DB_USER=erdms_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# APPLICATION VERSION
# -----------------------------------------------------------------------------
# DEV:
REACT_APP_VERSION=2.21-DEV

# PRODUCTION:
# REACT_APP_VERSION=2.17

# -----------------------------------------------------------------------------
# UPLOAD PATHS
# -----------------------------------------------------------------------------
# ⚠️ KRITICKÉ: Tyto cesty určují, kam se ukládají přílohy!

# Environment type - CRITICAL for automatic path detection
APP_ENV=development

# DEV používá /var/www/erdms-dev/data/ (testovací data):
UPLOAD_ROOT_PATH=/var/www/erdms-dev/data/eeo-v2/prilohy/
DOCX_TEMPLATES_PATH=/var/www/erdms-dev/data/eeo-v2/sablony/
MANUALS_PATH=/var/www/erdms-dev/data/eeo-v2/manualy/

# PRODUCTION používá /var/www/erdms-platform/data/ (OSTRÁ DATA!):
# APP_ENV=production  
# UPLOAD_ROOT_PATH=/var/www/erdms-platform/data/eeo-v2/prilohy/
# DOCX_TEMPLATES_PATH=/var/www/erdms-platform/data/eeo-v2/sablony/
# MANUALS_PATH=/var/www/erdms-platform/data/eeo-v2/manualy/

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# 1. DEV server (/var/www/erdms-dev/):
#    - Používá eeo2025-dev databázi
#    - Ukládá do /var/www/erdms-dev/data/
#    - Port 3001 (Apache Alias /dev/)
#
# 2. PRODUCTION server (/var/www/erdms-platform/):
#    - Používá eeo2025 databázi
#    - Ukládá do /var/www/erdms-platform/data/
#    - Hlavní doména
#
# 3. NIKDY neměnit produkční .env bez explicitního potvrzení!
#
# =============================================================================
