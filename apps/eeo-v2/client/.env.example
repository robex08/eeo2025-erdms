# Příklad konfigurace .env souboru

# 🔐 ENCRYPTION DEBUG MODE
# Nastavit na 'true' pouze při debugování - vypne šifrování citlivých dat
# VAROVÁNÍ: V produkci VŽDY nastavit na 'false' nebo odstranit!
# - false = normální šifrování (default)  
# - true = DEBUG režim - data nejsou šifrována (pouze pro debugování)
REACT_APP_ENCRYPTION_DEBUG=false

# ⚠️⚠️⚠️ KRITICKÉ UPOZORNĚNÍ ⚠️⚠️⚠️
# NIKDY NEPOUŽÍVEJ: eeo.zachranka.cz - TO JE ŠPATNĚ!
# VŽDY POUŽÍVEJ: erdms.zachranka.cz pro PRODUKCI
# ⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️⚠️

# Ostatní konfigurace...
REACT_APP_DB_ORDER_KEY=DEMO_objednavky_2025
REACT_APP_API_BASE_URL=https://erdms.zachranka.cz/api
REACT_APP_API2_BASE_URL=https://erdms.zachranka.cz/api.eeo/

# Database name for footer display
REACT_APP_DB_NAME=EEO2025

# Application version (universal - used everywhere)
REACT_APP_VERSION=2.37
